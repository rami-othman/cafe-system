  ,"productDetailArchiveMessage": "\u0644\u0646 \u064a\u0639\u0648\u062f \u0647\u0630\u0627 \u0627\u0644\u0645\u0646\u062a\u062c \u0645\u062a\u0627\u062d\u064b\u0627 \u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u062c\u062f\u064a\u062f \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u0639\u0627\u062f\u064a. \u0644\u0627 \u062a\u062a\u063a\u064a\u0631 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0648\u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0629 \u0627\u0644\u0633\u0627\u0628\u0642\u0629."
  ,"productDetailRestoreMessage": "\u064a\u0639\u064a\u062f \u0647\u0630\u0627 \u0627\u0644\u0645\u0646\u062a\u062c \u0625\u0644\u0649 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u0639\u062f\u064a\u0644. \u0648\u062a\u0628\u0642\u0649 \u0625\u062a\u0627\u062d\u062a\u0647 \u0645\u0639\u062a\u0645\u062f\u0629 \u0639\u0644\u0649 \u062a\u0639\u064a\u064a\u0646\u0627\u062a \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0648\u0627\u0644\u062c\u062f\u0627\u0648\u0644 \u0648\u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0648\u0627\u0644\u0646\u0634\u0631."
  ,"productCatalogArchiveMessage": "\u0644\u0646 \u064a\u0639\u0648\u062f \u0647\u0630\u0627 \u0627\u0644\u0645\u0646\u062a\u062c \u0645\u062a\u0627\u062d\u064b\u0627 \u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u062c\u062f\u064a\u062f \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u0639\u0627\u062f\u064a.\n\n\u0644\u0627 \u064a\u064f\u062d\u0630\u0641 \u0627\u0644\u0645\u0646\u062a\u062c \u0646\u0647\u0627\u0626\u064a\u064b\u0627. \u0644\u0627 \u062a\u064f\u062d\u0630\u0641 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u0639\u062f\u0651\u0644\u0627\u062a \u0627\u0644\u0645\u0631\u0643\u0632\u064a\u0629\u060c \u0648\u062a\u0628\u0642\u0649 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0645\u062e\u0632\u0646\u0629 \u062d\u0633\u0628 \u0633\u0644\u0648\u0643 \u0627\u0644\u062e\u0644\u0641\u064a\u0629."
