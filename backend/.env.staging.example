# Copy to the ignored .env.staging only for explicit Supabase staging work.
# Normal .env remains the local PostgreSQL development environment.
APP_ENV=staging
APP_DEBUG=false
APP_KEY=<YOUR_EXISTING_LARAVEL_APP_KEY>
APP_URL=<YOUR_STAGING_API_HTTPS_URL>
LOG_CHANNEL=stderr

# Approved Supabase Session Pooler. Replace only the password placeholder and
# percent-encode URI-special characters in the password.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.uowuallmnboeqhsydzlk:<PERCENT_ENCODED_PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSLMODE=require

# Product image storage: public Supabase bucket, server-side S3 credentials.
PRODUCT_IMAGE_DISK=supabase-product-images
SUPABASE_STORAGE_ENDPOINT=https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_STORAGE_ACCESS_KEY_ID=<S3_ACCESS_KEY_ID>
SUPABASE_STORAGE_SECRET_ACCESS_KEY=<S3_SECRET_ACCESS_KEY>
SUPABASE_STORAGE_USE_PATH_STYLE=true
SUPABASE_STORAGE_PUBLIC_URL=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/product-images

# Required only by staging:initialize. Do not use predictable values.
STAGING_OWNER_PASSWORD=<TEMPORARY_OWNER_PASSWORD>
STAGING_MANAGER_PASSWORD=<TEMPORARY_MANAGER_PASSWORD>
STAGING_EMPLOYEE_PASSWORD=<TEMPORARY_EMPLOYEE_PASSWORD>
STAGING_OWNER_EMAIL=staging-owner@cafe618.invalid
STAGING_MANAGER_EMAIL=staging-manager@cafe618.invalid
STAGING_EMPLOYEE_EMAIL=staging-cashier@cafe618.invalid
STAGING_EMPLOYEE_USERNAME=staging-cashier
