# =============================================================================
# Finjan production environment template — backend/.env
# =============================================================================
# This file is a TEMPLATE ONLY. It is safe to commit (no real secrets).
# install.sh generates the real backend/.env interactively and NEVER writes
# secret values to Git, logs, or terminal output. Copy this file manually
# only if you are building .env by hand instead of running install.sh.
#
# Every <PLACEHOLDER> below must be replaced with a real value before the
# application will boot. install.sh prompts for all of them.

APP_NAME="Cafe System 618"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.cafesystemsyria.com

# Preserve the EXISTING production APP_KEY if one already protects live data
# (sessions, signed URLs, cookies). See deployment/finjan/FINDINGS.md for why
# this codebase currently has no persisted Crypt-encrypted columns, but
# rotating APP_KEY still invalidates all existing sessions/signed URLs.
APP_KEY=<PRESERVE_EXISTING_OR_GENERATE_NEW>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Reverse proxy (Nginx on the same host) ---------------------------------
# Loopback only: Nginx is the only thing in front of PHP-FPM on this VPS.
TRUSTED_PROXIES=127.0.0.1
CORS_ALLOWED_ORIGINS=https://admin.cafesystemsyria.com

# --- Database: LOCAL PostgreSQL on this VPS (no Supabase, no DB_URL) -------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cafe618_production
DB_USERNAME=cafe618_app
DB_PASSWORD=<GENERATED_BY_INSTALL_SH>
# DB_SSLMODE intentionally unset: config/database.php defaults to "prefer",
# which is correct and sufficient for a same-host TCP/loopback connection.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# --- Queue -------------------------------------------------------------------
# No ShouldQueue job classes and no jobs/failed_jobs migration exist in this
# codebase today (see FINDINGS.md). "sync" is the CORRECT production value,
# not a leftover from staging. Do not change this without adding the queue
# tables and a real supervised worker.
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@cafesystemsyria.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Local product-image storage (replaces Supabase Storage) ---------------
# product-images-local is already the application default disk; this line is
# set explicitly so a stale environment can never silently fall back to
# Supabase. See config/filesystems.php and config/product-images.php.
FILESYSTEM_DISK=local
PRODUCT_IMAGE_DISK=product-images-local

# --- Super Admin platform bootstrap (first-run only; rotate after use) ------
SUPER_ADMIN_NAME="Cafe 618 Platform Admin"
SUPER_ADMIN_EMAIL=<PLATFORM_ADMIN_EMAIL>
SUPER_ADMIN_PASSWORD=<GENERATED_BY_INSTALL_SH>
